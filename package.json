{
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/make-iife-string.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "name": "@camada/browser",
  "description": "camada fingerprint beacon: browser module + self-initializing IIFE served first-party by the backend SDKs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./iife": "./dist/auto.global.js",
    "./iife-string": {
      "import": {
        "types": "./dist/iife-string.d.ts",
        "default": "./dist/iife-string.js"
      },
      "require": {
        "types": "./dist/iife-string.d.cts",
        "default": "./dist/iife-string.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "iife-string": [
        "./dist/iife-string.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
